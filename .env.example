APP_NAME="Transcritor Web"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://transcritor.example.com
APP_PORT=8000
APP_ACCESS_PASSWORD=change-me

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR
APP_TIMEZONE=America/Sao_Paulo

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/storage/app/database.sqlite
DB_FOREIGN_KEYS=true
DB_BUSY_TIMEOUT=10000
DB_JOURNAL_MODE=WAL
DB_SYNCHRONOUS=NORMAL
DB_TRANSACTION_MODE=DEFERRED

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

FILESYSTEM_DISK=local
CACHE_STORE=file

QUEUE_CONNECTION=database
QUEUE_FAILED_DRIVER=null
DB_QUEUE_CONNECTION=sqlite
DB_QUEUE_TABLE=jobs
DB_QUEUE=default
DB_QUEUE_RETRY_AFTER=25500

MAIL_MAILER=log
MAIL_FROM_ADDRESS="transcritor@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
GOOGLE_OAUTH_CLIENT_ID=

USD_BRL_FALLBACK_RATE=5.00
TRANSCRIPTION_MIN_FREE_DISK_MB=512
